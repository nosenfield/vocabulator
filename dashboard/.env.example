# Vocabulator Dashboard Environment Variables
# Copy this file to .env and update with your values

# API Backend URL (required in production)
# For local development, defaults to http://localhost:8000/api/v1 if not set
# In production builds, this MUST be set or the application will fail to start
VITE_API_BASE=http://localhost:8000/api/v1

# Example production configuration:
# VITE_API_BASE=https://api.vocabulator.com/api/v1
