# Dockerfile for building Lambda deployment package
# Uses Amazon Linux 2 to match Lambda runtime environment

FROM public.ecr.aws/lambda/python:3.11

# Set working directory
WORKDIR /var/task

# Copy requirements first (for better caching)
COPY requirements.txt /var/task/

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ /var/task/src/
COPY lambda_handler.py /var/task/
COPY pyproject.toml /var/task/

# Set Python path
ENV PYTHONPATH=/var/task

# Lambda handler is set via CMD or can be overridden
CMD ["lambda_handler.lambda_handler"]

